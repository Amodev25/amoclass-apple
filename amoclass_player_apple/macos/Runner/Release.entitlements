<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  The App Sandbox is OFF.

	  It was turned off for Focus Mode, whose kiosk presentation options the
	  sandbox blocks. The owner removed Focus Mode on 2026-09-14, so that reason
	  no longer exists; the key has not been flipped back yet because nothing
	  has been tested sandboxed. Turning it on needs, at least,
	  com.apple.security.files.user-selected.read-only for the import picker,
	  and a check of everything else the app does (keychain, IOKit device id,
	  mpv). It is also what the Mac App Store requires. macOS currently ships as a Developer ID signed, notarised
	  DMG straight from the site.

	  With no sandbox there is no need for files.user-selected entitlements
	  — reading the student's lesson files is unrestricted.
	-->
	<key>com.apple.security.app-sandbox</key>
	<false/>

	<!-- Login, licence verification and the online library all call the API. -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
